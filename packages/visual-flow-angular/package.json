{
  "name": "@lumeflow/angular",
  "version": "0.1.0",
  "description": "Standalone Angular component for rendering portable @lumeflow/core diagrams with browser-safe lifecycle management and SSR guards.",
  "license": "MIT",
  "author": "LumeFlow contributors",
  "homepage": "https://sentimental37.github.io/lumeflow-showcase/",
  "bugs": {
    "url": "https://github.com/sentimental37/lumeflow/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sentimental37/lumeflow.git",
    "directory": "packages/visual-flow-angular"
  },
  "keywords": [
    "angular",
    "architecture-diagrams",
    "diagram-as-code",
    "standalone-component",
    "svg",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/fesm2022/visual-flow-angular.mjs",
  "types": "./dist/types/visual-flow-angular.d.ts",
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "typecheck": "ngc -p tsconfig.lib.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "clean": "rimraf dist .turbo test/.out"
  },
  "dependencies": {
    "@lumeflow/core": "^0.1.0",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@angular/common": "^17.3 || ^18.2 || ^19.2 || ^20 || ^21 || ^22",
    "@angular/core": "^17.3 || ^18.2 || ^19.2 || ^20 || ^21 || ^22"
  },
  "devDependencies": {
    "@angular/common": "21.2.20",
    "@angular/compiler-cli": "21.2.20",
    "@angular/core": "21.2.20",
    "ng-packagr": "21.2.7",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
