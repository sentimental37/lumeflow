{
  "name": "@lumeflow/react",
  "version": "0.1.0",
  "description": "React canvas, editing primitives, and React Flow adapter for @lumeflow/core diagrams.",
  "license": "MIT",
  "author": "LumeFlow contributors",
  "homepage": "https://sentimental37.github.io/lumeflow-showcase/",
  "bugs": {
    "url": "https://github.com/sentimental37/lumeflow/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sentimental37/lumeflow.git",
    "directory": "packages/visual-flow-react"
  },
  "keywords": [
    "react",
    "architecture-diagrams",
    "diagram-as-code",
    "visual-editor",
    "react-flow",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": ["dist"],
  "sideEffects": ["*.css"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@lumeflow/core": "^0.1.0",
    "@xyflow/react": "^12.11.3"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
